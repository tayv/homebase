          <div
            class="hero-copy flex w-full flex-col items-center justify-center"
          >
            <h1
              aria-label={heroTitle}
              class="text-md w-full px-2 text-center font-[divenire,sans-serif] font-bold tracking-widest break-words text-white uppercase drop-shadow-lg sm:text-xl"
