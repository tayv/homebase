              </div>
              <div class="font-regular text-md w-full text-center text-white">
                <em>DESIGNER noun(2)</em>&nbsp; ◦ &nbsp;A SCHEMER, INTRIGUER, OR
                PLOTTER.
              </div>
              <nav
                aria-label="Social profiles"
                class="mt-4 flex items-center justify-center gap-4 text-sm font-light tracking-widest text-white uppercase"
              >
                <a
                  class="hero-social-link whitespace-nowrap underline transition-colors"
                  href="https://linkedin.com/in/taylorvanderhelm">linkedin</a
                >
                <span aria-hidden="true">|</span>
                <a
                  class="hero-social-link whitespace-nowrap underline transition-colors"
                  href="https://x.com/vantaylor_">X (Twitter)</a
                >
                <span aria-hidden="true">|</span>
                <a
                  class="hero-social-link whitespace-nowrap underline transition-colors"
                  href="https://github.com/tayv">github</a
                >
              </nav>
            </div>
          </div>
          <!-- marquee starts -->
          <!-- <div class="relative w-full overflow-hidden py-2">
            <div class="animate-marquee inline-flex">
              <ul class="flex gap-16 pr-16 text-lg">
                <li class="shrink-0 whitespace-nowrap">
