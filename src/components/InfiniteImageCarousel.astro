---
const carouselImages = Array.from({ length: 18 }, (_, index) => ({
  src: `/carousel/carousel-${String(index + 1).padStart(2, "0")}.jpg`,
  alt: `Portfolio artwork ${index + 1}`,
}))
---

<div class="image-carousel" aria-label="Project image gallery">
  <h2
    class="mb-2 w-full text-center text-xs font-semibold tracking-widest text-[#2b2b2b] uppercase md:text-sm"
  >
    Midjourney
  </h2>
  <div class="image-carousel__track items-end">
    <div class="image-carousel__group items-end">
      {
        carouselImages.map(({ src, alt }) => (
          <img
            class="image-carousel__image grayscale transition-[filter,transform] duration-300 ease-out hover:z-[1] hover:scale-[1.45] hover:grayscale-0 motion-reduce:transition-[filter]"
            src={src}
            alt={alt}
            loading="lazy"
            decoding="async"
            style="border: 0; transform-origin: center bottom;"
          />
        ))
      }
    </div>

    <div class="image-carousel__group items-end" aria-hidden="true">
      {
        carouselImages.map(({ src }) => (
          <img
            class="image-carousel__image grayscale transition-[filter,transform] duration-300 ease-out hover:z-[1] hover:scale-[1.45] hover:grayscale-0 motion-reduce:transition-[filter]"
            src={src}
            alt=""
            loading="lazy"
            decoding="async"
            style="border: 0; transform-origin: center bottom;"
          />
        ))
      }
    </div>
  </div>
</div>

<style>
  .image-carousel {
    --tile-width: clamp(7rem, 11vw, 10rem);
    --tile-height: clamp(5rem, 8vw, 7.25rem);
    --tile-gap: clamp(0.35rem, 0.6vw, 0.65rem);
    width: 100%;
    overflow: hidden;
    padding-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .image-carousel__track {
    display: flex;
    width: max-content;
    animation: image-carousel-scroll 65s linear infinite;
    will-change: transform;
  }

  .image-carousel__group {
    display: flex;
    flex-shrink: 0;
    gap: var(--tile-gap);
    padding-right: var(--tile-gap);
  }

  .image-carousel__image {
    width: var(--tile-width);
    height: var(--tile-height);
    flex-shrink: 0;
    box-sizing: border-box;
    background-color: #252525;
    object-fit: cover;
  }

  @keyframes image-carousel-scroll {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .image-carousel__track {
      animation-play-state: paused;
    }
  }
</style>
